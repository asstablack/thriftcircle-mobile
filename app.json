{
  "expo": {
    "name": "ThriftCircle",
    "slug": "thriftcircle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/thrift-circle-logo.png",
    "scheme": "thriftcirclemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thriftcircle.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/figma/ec34e.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FCFBF8",
          "dark": {
            "image": "./assets/figma/ec34e.png",
            "backgroundColor": "#FCFBF8"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5728882a-b022-48b7-96cc-a00a2cdc1037"
      }
    }
  }
}
